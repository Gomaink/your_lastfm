{
  "name": "your_lastfm",
  "version": "1.1.2",
  "description": "Self-hosted Last.fm scrobble dashboard, sync service and recap generator",
  "main": "src/api.js",
  "scripts": {
    "start": "node src/api.js",
    "start:cron": "node src/cron.js",
    "sync": "node src/index.js",
    "sync:full": "node src/index.js --full",
    "sync:initial": "node src/initial-sync.js",
    "check": "node scripts/check.js",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "lastfm",
    "scrobbles",
    "dashboard",
    "self-hosted"
  ],
  "author": "Gomaink",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.13.2",
    "better-sqlite3": "^12.5.0",
    "canvas": "^3.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "fast-csv": "^5.0.5",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1"
  },
  "engines": {
    "node": ">=22"
  }
}
