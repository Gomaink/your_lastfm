LASTFM_API_KEY=your_lastfm_api_key
LASTFM_USERNAME=your_lastfm_username
PORT=1533

# Synchronization
SYNC_CRON=*/5 * * * *
INTEGRITY_CRON=0 3 * * *
SYNC_OVERLAP_SECONDS=86400
LASTFM_REQUEST_DELAY_MS=250
LASTFM_REQUEST_TIMEOUT_MS=15000

# External images and recap generation
IMAGE_REQUEST_TIMEOUT_MS=10000
IMAGE_FAILURE_CACHE_MS=600000
METADATA_FAILURE_CACHE_MS=600000
EXTERNAL_REQUEST_CONCURRENCY=4
FRIENDS_CACHE_TTL_MS=300000
SHARE_IMAGE_CONCURRENCY=4
SHARE_MAX_CONCURRENT=2
SHARE_IMAGE_MAX_BYTES=10485760

# Optional: comma-separated origins allowed to call the API from another website.
# Leave empty for same-origin access only.
CORS_ORIGIN=

# PM2 process memory limits
API_MAX_MEMORY=512M
CRON_MAX_MEMORY=256M
